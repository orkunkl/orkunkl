---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout description="Orkun Külçe — blockchain technologist in the Cosmos ecosystem, interested in regeneration and non-dual philosophy.">
  <section class="rose-hero">
    <img class="rose-hero-img" src="/img/rose-single.webp"
         alt="A rose lit in electric blue and crimson" width="1200" height="1200" loading="eager">
    <div class="rose-hero-copy">
      <h1 class="rose-hero-title">I'm <em>{site.name}</em>,<br><i class="rose-hero-sub">{site.tagline}.</i></h1>
    </div>
  </section>

  <div class="page page-body">
    <p class="lead">{site.bio}</p>
    <p>{site.practice}</p>

    <hr>

    <div class="quick-links">
      <a href="/about" class="quick-card">
        <div class="label">About</div>
        <div class="title">Me</div>
      </a>
      <a href="/work" class="quick-card">
        <div class="label">Work</div>
        <div class="title">Things I build</div>
      </a>
      <a href="/canon" class="quick-card">
        <div class="label">Canon</div>
        <div class="title">Books and teachings</div>
      </a>
    </div>
  </div>
</BaseLayout>
