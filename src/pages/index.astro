---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout description="Orkun Külçe — blockchain technologist in the Cosmos ecosystem, interested in regeneration and non-dual philosophy.">
  <section class="rose-hero">
    <img class="rose-hero-img" src="/img/rose-single.webp"
         alt="A rose lit in electric blue and crimson" width="1200" height="1200" loading="eager">
    <div class="rose-hero-copy">
      <h1 class="rose-hero-title">I'm <em>Orkun Külçe</em>,<br><i class="rose-hero-sub">a builder, mover, and thinkerer.</i></h1>
    </div>
  </section>

  <div class="page page-body">
    <p class="lead">
      I'm a blockchain technologist and metamodern mystic. Most of my
      work has been in the Cosmos ecosystem — smart contracts in Rust, including
      StreamSwap on Osmosis, and developer relations for CosmWasm. I breathe with
      decentralized systems and existences, and I'm interested in regeneration and
      non-dual philosophies and practices.
    </p>
    <p>
      I practice yoga, flow arts and movement.
    </p>
  </div>

  <div class="page page-body">
    <hr>

    <div class="quick-links">
      <a href="/about" class="quick-card">
        <div class="label">About</div>
        <div class="title">Who I am and what I believe</div>
      </a>
      <a href="/work" class="quick-card">
        <div class="label">Work</div>
        <div class="title">Things I build and have built</div>
      </a>
      <a href="/canon" class="quick-card">
        <div class="label">Canon</div>
        <div class="title">Books and teachings that shaped me</div>
      </a>
    </div>
  </div>
</BaseLayout>
