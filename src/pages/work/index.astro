---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Work" description="Things Orkun Ravi Külçe is building and has built.">
  <div class="page page-header">
    <p class="back-link"><a href="/">← Home</a></p>
  </div>
  <div class="page page-body">
    <figure class="work-logo">
      <img src="/img/rose-emblem.webp"
           alt="A white rose over crossed thorny stems, inside a black circle on a white patch"
           width="600" height="600">
      <figcaption class="work-quote">
        <blockquote>
          Heed my words, Struggler. Struggle, endure, contend. For that alone is the
          sword of one who confronts death.
        </blockquote>
        <cite>— Skull Knight</cite>
      </figcaption>
    </figure>
    <h2><span class="hash">#</span>Work</h2>
    <p class="section-lede">
      Things I've built and worked on. Each one has a page of its own.
    </p>

    {entries.length === 0 ? (
      <div class="empty">
        <p>Nothing here yet.</p>
        <p class="empty-hint">
          Add a Markdown file to <code>src/content/work/</code> — copy
          <code>_template.md</code> and fill it in. This page picks it up on the
          next build.
        </p>
      </div>
    ) : (
      <div class="card-grid">
        {entries.map((entry) => (
          <a href={`/work/${entry.id}`} class="card card-link">
            <div class="card-head">
              <h3>{entry.data.title}</h3>
              {entry.data.period && <span class="period">{entry.data.period}</span>}
            </div>
            {entry.data.role && <div class="role">{entry.data.role}</div>}
            <p>{entry.data.summary}</p>
            {entry.data.tags.length > 0 && (
              <div class="tags">
                {entry.data.tags.map((t) => <span>{t}</span>)}
              </div>
            )}
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
