---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="About" description="Orkun Külçe — blockchain technologist in the Cosmos ecosystem.">
  <div class="page page-header">
    <p class="back-link"><a href="/">← Home</a></p>
  </div>
  <div class="page page-body">
    <figure class="about-rose">
      <img src="/img/rose-bouquet.webp"
           alt="A bouquet of roses lit in electric blue and crimson" width="1200" height="1200"
           loading="eager">
    </figure>

    <h2><span class="hash">#</span>About</h2>

    <div class="about-grid">
      <div class="about-sidebar">
        <span class="label">Name</span>
        <span class="value highlight">{site.name}</span>
        <span class="label">Location</span>
        <span class="value">Türkiye</span>
        <span class="label">Interests</span>
        <span class="value">Decentralized Systems<br>Regeneration<br>Flow Art</span>
      </div>
      <div>
        {site.lead.map((para) => <p>{para}</p>)}
      </div>
    </div>
  </div>
</BaseLayout>
