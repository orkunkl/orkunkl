---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('canon')).sort((a, b) => a.data.order - b.data.order);

// Shelf order. The practical and technical material leads; the spiritual
// shelves are deliberately last.
const CATEGORY_ORDER = [
  'Meaning & the Mind',
  'Language & Relationship',
  'Image & Spectacle',
  'Technology & Sovereignty',
  'Content & Influences',
  'Systems & Coordination',
  'Abuse, Power & Repair',
  'The Non-Dual and Remembering',
  'Sound & Vibration',
];

const byCategory = new Map<string, typeof entries>();
for (const entry of entries) {
  const cat = entry.data.category;
  if (!byCategory.has(cat)) byCategory.set(cat, []);
  byCategory.get(cat)!.push(entry);
}

// listed shelves first, in the order above; a new category lands after them
const order = [
  ...CATEGORY_ORDER.filter((c) => byCategory.has(c)),
  ...[...byCategory.keys()].filter((c) => !CATEGORY_ORDER.includes(c)),
];
---

<BaseLayout title="Canon" description="Books, texts and teachings that shaped how Orkun Külçe thinks.">
  <div class="page page-header">
    <p class="back-link"><a href="/">← Home</a></p>
  </div>
  <div class="page page-body">
    <figure class="canon-mark">
      <img src="/img/hermes-mark.webp" alt="Hermes emblem" width="800" height="800">
    </figure>
    <h2><span class="hash">#</span>Canon</h2>
    <p class="section-lede">
      Books and teachings. Each entry leads with the one line I'd give someone who asked
      why it matters.
    </p>
    <p class="canon-note">
      <strong>Disclaimer:</strong> this page is not a declaration of who I am or what I
      stand for. I read from every side — including positions I don't hold — because
      emergence only shows itself from more than one place.
    </p>

    {entries.length === 0 ? (
      <div class="empty">
        <p>Nothing here yet.</p>
        <p class="empty-hint">
          Add a Markdown file to <code>src/content/canon/</code> — copy
          <code>_template.md</code> and fill it in. <code>whyItMatters</code> is the
          one required field beyond the title.
        </p>
      </div>
    ) : (
      order.map((category) => (
        <section class="canon-group">
          <h3 class="canon-group-title">
            <span class="hash">#</span>{category}
          </h3>
          <ul class="canon-list">
            {byCategory.get(category)!.map((entry) => (
              <li class="canon-item">
                <a href={`/canon/${entry.id}`} class="canon-link">
                  <div class="canon-top">
                    <span class={`kind kind-${entry.data.kind}`}>{entry.data.kind}</span>
                    <span class="canon-title">{entry.data.title}</span>
                  </div>
                  {entry.data.author && (
                    <div class="canon-author">
                      {entry.data.author}{entry.data.year ? ` · ${entry.data.year}` : ''}
                    </div>
                  )}
                  <p class="canon-why">{entry.data.whyItMatters}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    )}
  </div>
</BaseLayout>
